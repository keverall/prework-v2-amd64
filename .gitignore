*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
*.env
*.env.*
!.env.example
secrets/
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*
*.secret

# Docker / containers
.docker/
docker-compose.override.yml
*.log
*.pid
*.sock

# Prework/lane artifacts (large images, runtime state)
lane-image-*.tar.gz
lane-image-*/
.prework-*
prework_output/
model_a/
prework-manifest.json
.prework-docker.json
.prework-task-id
.prework-run-id

# Mercor prework runtime (host-side)
.mercor-prework/
*.local

# IDEs/editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS files
ehthumbs.db
Icon?
Desktop.ini

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Build artifacts
*.tar
*.zip
*.gz
!lane-image-*.tar.gz  # But we explicitly ignore lane images above; ensure coverage

